
# Core system tools (newer than macOS built-ins)
brew "git"
brew "openssh"
brew "rsync"
brew "make"
brew "autoconf"
brew "automake"
brew "pkg-config"
brew "cmake"

# Languages / runtimes
brew "python" # 全局版本，为一些脚本兜底
brew "uv" # 开发python项目时，管理python版本
brew "nvm"
# brew "ruby" # 明确需要时再安装

# CLI utilities (no conflict with system)
brew "trash"
brew "just"
brew "ssh-copy-id"
brew "lrzsz"
brew "sevenzip"

# Shell / prompt / dotfiles
brew "starship"
brew "chezmoi"
brew "zinit"

# Modern CLI tools
brew "zoxide"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "sd"
brew "eza"
brew "git-delta"
brew "topgrade"

# MAS 命令行
brew "mas"
